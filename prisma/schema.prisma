generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String         @id @default(cuid())
  name      String
  timezone  String         @default("America/Chicago")
  createdAt DateTime       @default(now())
  slots     DisplaySlot[]
  games     Game[]
  packs     Pack[]
  scanLogs  ScanLogEntry[]
  shifts    Shift[]
  shipments Shipment[]
  users     User[]

  @@map("stores")
}

model User {
  id                String         @id @default(cuid())
  storeId           String
  email             String         @unique
  passwordHash      String
  name              String
  role              Role           @default(CLERK)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  lastLoginAt       DateTime?
  packsReceived     Pack[]         @relation("PacksReceivedBy")
  scanLogs          ScanLogEntry[] @relation("ScanLogPerformedBy")
  shiftsClosed      Shift[]        @relation("ShiftsClosedBy")
  shiftsOpened      Shift[]        @relation("ShiftsOpenedBy")
  shipmentsReceived Shipment[]     @relation("ShipmentsReceived")
  store             Store          @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("users")
}

model Shipment {
  id                         String         @id @default(cuid())
  storeId                    String
  receivedById               String
  invoiceNumber              String
  invoicePhoto               String?
  expectedPacks              Int
  scannedPacks               Int            @default(0)
  status                     ShipmentStatus @default(IN_PROGRESS)
  createdAt                  DateTime       @default(now())
  confirmedAt                DateTime?
  shipmentDate               DateTime?
  confirmationReceiptPhoto   String?
  shipmentConfirmationNumber String?
  packs                      Pack[]
  receivedBy                 User           @relation("ShipmentsReceived", fields: [receivedById], references: [id])
  store                      Store          @relation(fields: [storeId], references: [id])

  @@unique([storeId, invoiceNumber])
  @@index([storeId])
  @@map("shipments")
}

model Game {
  id             String   @id @default(cuid())
  storeId        String
  gameNumber     String
  name           String
  price          Decimal  @db.Decimal(10, 2)
  ticketsPerPack Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id])
  packs          Pack[]

  @@unique([storeId, gameNumber])
  @@index([storeId])
  @@map("games")
}

model Pack {
  id                     String              @id @default(cuid())
  storeId                String
  gameId                 String
  serialNumber           String
  status                 PackStatus          @default(BACK_STOCK)
  cost                   Decimal             @db.Decimal(10, 2)
  retailValue            Decimal             @db.Decimal(10, 2)
  receivedAt             DateTime            @default(now())
  receivedById           String
  activatedAt            DateTime?
  currentTicketNumber    Int?
  notes                  String?
  shipmentId             String?
  activationReceipt      String?
  firstTicket            Int?
  gameNumber             String?
  invoiceReceipt         String?
  packNumber             String?
  ticketPrice            Decimal?            @db.Decimal(10, 2)
  ticketQuantity         Int?
  activationNumber       String?
  completedAt            DateTime?
  firstOrLastTicket      String?
  lotNumber              String?
  packImage              String?
   
  // Phase 2: Backstock activation details
  activationReceiptPhoto String?
   
  // Phase 2: Backstock removal tracking
  removalReason          BackstockRemovalReason?
  removalReasonText      String?
  removalReasonAt        DateTime?
   
  // Phase 2: Active pack removal/reassignment tracking
  activeRemovalReason    ActiveRemovalReason?
  activeRemovalReasonText String?
  activeRemovalReasonAt  DateTime?
  reassignedToSlotId     String?
   
  slot                   DisplaySlot?
  game                   Game                @relation(fields: [gameId], references: [id])
  receivedBy             User                @relation("PacksReceivedBy", fields: [receivedById], references: [id])
  shipment               Shipment?           @relation(fields: [shipmentId], references: [id])
  store                  Store               @relation(fields: [storeId], references: [id])
  scanLogs               ScanLogEntry[]
  shiftLines             ShiftLine[]

  @@unique([storeId, serialNumber])
  @@index([storeId, status])
  @@index([shipmentId])
  @@map("packs")
}

model DisplaySlot {
  id         String   @id @default(cuid())
  storeId    String
  slotNumber String
  packId     String?  @unique
  createdAt  DateTime @default(now())
  pack       Pack?    @relation(fields: [packId], references: [id])
  store      Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, slotNumber])
  @@index([storeId])
  @@map("display_slots")
}

model Shift {
  id         String      @id @default(cuid())
  storeId    String
  status     ShiftStatus @default(OPEN)
  openedAt   DateTime    @default(now())
  openedById String
  closedAt   DateTime?
  closedById String?
  lines      ShiftLine[]
  closedBy   User?       @relation("ShiftsClosedBy", fields: [closedById], references: [id])
  openedBy   User        @relation("ShiftsOpenedBy", fields: [openedById], references: [id])
  store      Store       @relation(fields: [storeId], references: [id])

  @@index([storeId, status])
  @@map("shifts")
}

model ShiftLine {
  id              String   @id @default(cuid())
  shiftId         String
  packId          String
  slotNumber      String
  beginningTicket Int
  endingTicket    Int?
  ticketsSold     Int?
  salesAmount     Decimal? @db.Decimal(10, 2)
  pack            Pack     @relation(fields: [packId], references: [id])
  shift           Shift    @relation(fields: [shiftId], references: [id])

  @@unique([shiftId, packId])
  @@index([shiftId])
  @@map("shift_lines")
}

model ScanLogEntry {
  id            String     @id @default(cuid())
  storeId       String
  action        ScanAction
  packId        String?
  performedById String
  detail        String
  timestamp     DateTime   @default(now())
  pack          Pack?      @relation(fields: [packId], references: [id])
  performedBy   User       @relation("ScanLogPerformedBy", fields: [performedById], references: [id])
  store         Store      @relation(fields: [storeId], references: [id])

  @@index([storeId, timestamp])
  @@map("scan_log_entries")
}

enum Role {
  MANAGER
  CLERK
  VIEWER
}

enum ShipmentStatus {
  IN_PROGRESS
  RECEIVED
}

enum PackStatus {
  BACK_STOCK
  ACTIVE
  SOLD_OUT
  RETURNED
  COMPLETED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum ScanAction {
  RECEIVED
  ACTIVATED
  SOLD_OUT
  SHIFT_OPEN
  SHIFT_CLOSE
  RETURNED
}

enum BackstockRemovalReason {
  RETURNED
  LOST
  OTHER
}

enum ActiveRemovalReason {
  STOLEN
  RETURNED
  REASSIGNED
  OTHER
}
