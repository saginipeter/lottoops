generator client {
  provider = "prisma-client-js"
}
 
 
 //add
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id           String         @id @default(cuid())
  name         String
  timezone     String         @default("America/Chicago")
  address      String?
  phone        String?
  createdAt    DateTime       @default(now())
  ownerUserId  String?        // The OWNER user who created/owns this store
  organizationId String?
  slots        DisplaySlot[]
  games        Game[]
  packs        Pack[]
  scanLogs     ScanLogEntry[]
  shifts       Shift[]
  inventoryAudits InventoryAudit[]
  shipments    Shipment[]
  users        User[]
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("stores")
}

model User {
  id                 String         @id @default(cuid())
  storeId            String
  email              String         @unique
  passwordHash       String
  name               String
  role               Role           @default(EMPLOYEE)
  grantedPermissions String[]       @default([])
  active             Boolean        @default(true)
  createdAt         DateTime       @default(now())
  lastLoginAt       DateTime?
  packsReceived     Pack[]         @relation("PacksReceivedBy")
  scanLogs          ScanLogEntry[] @relation("ScanLogPerformedBy")
  shiftsClosed      Shift[]        @relation("ShiftsClosedBy")
  shiftsOpened      Shift[]        @relation("ShiftsOpenedBy")
  auditsBegun       InventoryAudit[] @relation("AuditsBegunBy")
  auditsEnded       InventoryAudit[] @relation("AuditsEndedBy")
  ownedOrganizations Organization[]  @relation("OrganizationOwner")
  shipmentsReceived Shipment[]     @relation("ShipmentsReceived")
  store             Store          @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@map("users")
}

model Organization {
  id                   String              @id @default(cuid())
  name                 String
  ownerUserId          String              @unique
  createdAt            DateTime            @default(now())
  owner                User                @relation("OrganizationOwner", fields: [ownerUserId], references: [id])
  stores               Store[]
  plan                 Plan?
  subscription         Subscription?
  paymentCustomer      PaymentCustomer?
  paymentEvents        PaymentEvent[]

  @@map("organizations")
}

model Plan {
  id                   String          @id @default(cuid())
  key                  String          @unique
  name                 String
  monthlyPriceCents    Int
  providerPriceId      String?         @unique
  active               Boolean         @default(true)
  organizationId       String?         @unique
  organization         Organization?   @relation(fields: [organizationId], references: [id])
  subscriptions        Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  planId               String
  providerSubscriptionId String?          @unique
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id])
  plan                 Plan               @relation(fields: [planId], references: [id])

  @@index([status])
  @@map("subscriptions")
}

model PaymentCustomer {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  providerCustomerId   String       @unique
  createdAt            DateTime     @default(now())
  organization         Organization @relation(fields: [organizationId], references: [id])

  @@map("payment_customers")
}

model PaymentEvent {
  id                   String       @id @default(cuid())
  organizationId       String?
  providerEventId      String       @unique
  eventType            String
  payload              Json
  processedAt           DateTime?
  createdAt             DateTime     @default(now())
  organization         Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("payment_events")
}

model Shipment {
  id                         String         @id @default(cuid())
  storeId                    String
  receivedById               String
  invoiceNumber              String
  invoicePhoto               String?
  expectedPacks              Int
  scannedPacks               Int            @default(0)
  status                     ShipmentStatus @default(IN_PROGRESS)
  createdAt                  DateTime       @default(now())
  confirmedAt                DateTime?
  shipmentDate               DateTime?
  confirmationReceiptPhoto   String?
  shipmentConfirmationNumber String?
  packs                      Pack[]
  receivedBy                 User           @relation("ShipmentsReceived", fields: [receivedById], references: [id])
  store                      Store          @relation(fields: [storeId], references: [id])

  @@unique([storeId, invoiceNumber])
  @@index([storeId])
  @@map("shipments")
}

model Game {
  id             String   @id @default(cuid())
  storeId        String
  gameNumber     String
  name           String
  price          Decimal  @db.Decimal(10, 2)
  ticketsPerPack Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  store          Store    @relation(fields: [storeId], references: [id])
  packs          Pack[]

  @@unique([storeId, gameNumber])
  @@index([storeId])
  @@map("games")
}

model Pack {
  id                     String              @id @default(cuid())
  storeId                String
  gameId                 String
  serialNumber           String
  status                 PackStatus          @default(BACK_STOCK)
  cost                   Decimal             @db.Decimal(10, 2)
  retailValue            Decimal             @db.Decimal(10, 2)
  receivedAt             DateTime            @default(now())
  receivedById           String
  activatedAt            DateTime?
  currentTicketNumber    Int?
  notes                  String?
  shipmentId             String?
  activationReceipt      String?
  firstTicket            Int?
  gameNumber             String?
  invoiceReceipt         String?
  packNumber             String?
  ticketPrice            Decimal?            @db.Decimal(10, 2)
  ticketQuantity         Int?
  activationNumber       String?
  completedAt            DateTime?
  firstOrLastTicket      String?
  lotNumber              String?
  packImage              String?
  sequenceLocked         Boolean             @default(false)
  sequenceLockExpectedTicket Int?
  sequenceLockScannedTicket  Int?
  sequenceLockBarcode       String?
  sequenceLockedAt           DateTime?
  sequenceLockedById         String?
   
  // Phase 2: Backstock activation details
  activationReceiptPhoto String?
   
  // Phase 2: Backstock removal tracking
  removalReason          BackstockRemovalReason?
  removalReasonText      String?
  removalReasonAt        DateTime?
   
  // Phase 2: Active pack removal/reassignment tracking
  activeRemovalReason    ActiveRemovalReason?
  activeRemovalReasonText String?
  activeRemovalReasonAt  DateTime?
  reassignedToSlotId     String?
   
  slot                   DisplaySlot?
  game                   Game                @relation(fields: [gameId], references: [id])
  receivedBy             User                @relation("PacksReceivedBy", fields: [receivedById], references: [id])
  shipment               Shipment?           @relation(fields: [shipmentId], references: [id])
  store                  Store               @relation(fields: [storeId], references: [id])
  scanLogs               ScanLogEntry[]
  shiftLines             ShiftLine[]
  auditLines             InventoryAuditLine[]

  @@unique([storeId, serialNumber])
  @@index([storeId, status])
  @@index([storeId, sequenceLocked])
  @@index([shipmentId])
  @@map("packs")
}

model DisplaySlot {
  id         String   @id @default(cuid())
  storeId    String
  slotNumber String
  packId     String?  @unique
  createdAt  DateTime @default(now())
  pack       Pack?    @relation(fields: [packId], references: [id])
  store      Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, slotNumber])
  @@index([storeId])
  @@map("display_slots")
}

model Shift {
  id         String      @id @default(cuid())
  storeId    String
  status     ShiftStatus @default(OPEN)
  openedAt   DateTime    @default(now())
  openedById String
  closedAt   DateTime?
  closedById String?
  lines      ShiftLine[]
  inventoryAudit InventoryAudit?
  closedBy   User?       @relation("ShiftsClosedBy", fields: [closedById], references: [id])
  openedBy   User        @relation("ShiftsOpenedBy", fields: [openedById], references: [id])
  store      Store       @relation(fields: [storeId], references: [id])

  @@index([storeId, status])
  @@map("shifts")
}

model InventoryAudit {
  id        String              @id @default(cuid())
  storeId   String
  shiftId   String              @unique
  status    InventoryAuditStatus @default(OPEN)
  begunById String
  begunAt   DateTime            @default(now())
  endedById String?
  endedAt   DateTime?
  store     Store               @relation(fields: [storeId], references: [id])
  shift     Shift               @relation(fields: [shiftId], references: [id])
  begunBy   User                @relation("AuditsBegunBy", fields: [begunById], references: [id])
  endedBy   User?               @relation("AuditsEndedBy", fields: [endedById], references: [id])
  lines     InventoryAuditLine[]

  @@index([storeId, status])
  @@map("inventory_audits")
}

model InventoryAuditLine {
  id                      String         @id @default(cuid())
  auditId                 String
  packId                  String
  slotNumber              String
  expectedTicket          Int
  endingExpectedTicket    Int?
  beginningPhysicalTicket Int?
  endingPhysicalTicket    Int?
  variance                Int?
  varianceReason          String?
  audit                   InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  pack                    Pack            @relation(fields: [packId], references: [id])

  @@unique([auditId, packId])
  @@index([packId])
  @@map("inventory_audit_lines")
}

model ShiftLine {
  id              String   @id @default(cuid())
  shiftId         String
  packId          String
  slotNumber      String
  beginningTicket Int
  endingTicket    Int?
  ticketsSold     Int?
  salesAmount     Decimal? @db.Decimal(10, 2)
  pack            Pack     @relation(fields: [packId], references: [id])
  shift           Shift    @relation(fields: [shiftId], references: [id])

  @@unique([shiftId, packId])
  @@index([shiftId])
  @@map("shift_lines")
}

model ScanLogEntry {
  id            String     @id @default(cuid())
  storeId       String
  action        ScanAction
  packId        String?
  performedById String
  detail        String
  timestamp     DateTime   @default(now())
  pack          Pack?      @relation(fields: [packId], references: [id])
  performedBy   User       @relation("ScanLogPerformedBy", fields: [performedById], references: [id])
  store         Store      @relation(fields: [storeId], references: [id])

  @@index([storeId, timestamp])
  @@map("scan_log_entries")
}

enum Role {
  OWNER
  MANAGER
  SHIFT_LEAD
  EMPLOYEE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum ShipmentStatus {
  IN_PROGRESS
  RECEIVED
}

enum PackStatus {
  BACK_STOCK
  ACTIVE
  SOLD_OUT
  RETURNED
  COMPLETED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum InventoryAuditStatus {
  OPEN
  COMPLETED
}

enum ScanAction {
  RECEIVED
  ACTIVATED
  SOLD_OUT
  SHIFT_OPEN
  SHIFT_CLOSE
  RETURNED
}

enum BackstockRemovalReason {
  RETURNED
  LOST
  OTHER
}

enum ActiveRemovalReason {
  STOLEN
  RETURNED
  REASSIGNED
  OTHER
}
