# Required in production
DATABASE_URL=
JWT_SECRET=
BLOB_READ_WRITE_TOKEN=

# Keep first-run provisioning locked in public deployments.
# Set to true only during the controlled initial setup, then remove or set false.
SETUP_ENABLED=false

# Keep false until a real payment provider and webhooks are connected.
BILLING_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false

# Development-only fallback. Keep false or unset in production.
ALLOW_OFFLINE_AUTH=false

# Optional WhatsApp report delivery
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SUMMARY_RECIPIENT=
